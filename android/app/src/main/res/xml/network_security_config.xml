<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Our Master uses raw TCP (no TLS). Allow cleartext so Android 9+ does not block it. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
