<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#22D4AF37" />
            <stroke android:width="1.5dp" android:color="#FFD84A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#11D4AF37" />
            <stroke android:width="1.5dp" android:color="#88D4AF37" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
