<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer soft glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_gold_soft" />
        </shape>
    </item>
    <!-- main gold disc with subtle gradient -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.3"
                android:gradientRadius="44dp"
                android:startColor="@color/accent_gold_bright"
                android:endColor="@color/accent_gold_variant" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_gold_deep" />
        </shape>
    </item>
</layer-list>
