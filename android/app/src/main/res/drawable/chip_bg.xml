<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient android:startColor="#FFE680" android:endColor="#D4AF37" android:angle="270" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#22D4AF37" />
            <stroke android:width="1dp" android:color="#FFD84A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#111328" />
            <stroke android:width="1dp" android:color="#2AD4AF37" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
