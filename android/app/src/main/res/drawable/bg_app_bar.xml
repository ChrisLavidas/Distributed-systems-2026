<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:startColor="#1E1547"
                android:centerColor="#110D30"
                android:endColor="#08060F"
                android:angle="270" />
        </shape>
    </item>
    <item android:top="-4dp" android:left="-4dp" android:right="-4dp">
        <shape>
            <stroke android:width="1dp" android:color="#33D4AF37" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
