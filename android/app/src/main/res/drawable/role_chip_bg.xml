<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/accent_gold_bright"
                android:endColor="@color/accent_gold_variant" />
            <corners android:radius="12dp" />
            <stroke android:color="@color/accent_gold_deep" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_variant" />
            <corners android:radius="12dp" />
            <stroke android:color="@color/divider" android:width="1dp" />
        </shape>
    </item>
</selector>
