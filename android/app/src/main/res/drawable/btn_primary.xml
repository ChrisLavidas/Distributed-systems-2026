<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#B07A0E" android:endColor="#8B6000" android:angle="270" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#44FFD84A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#44000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:startColor="#FFE680" android:centerColor="#FFD84A" android:endColor="#D4AF37" android:angle="270" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
