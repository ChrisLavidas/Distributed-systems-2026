<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen animated teal background -->
    <com.funGames.app.ui.TealCasinoBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ══════════ COMPACT APP BAR ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_mgr_app_bar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="10dp">

            <TextView
                android:id="@+id/btnLogoutMgrTop"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/mgr_teal_bright"
                android:textSize="30sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_casino_logo"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/app_name"/>

            <!-- Manager ID - compact inline -->
            <TextView
                android:id="@+id/tvManagerId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text=""
                android:textColor="@color/accent_gold"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#66FFD84A"
                android:shadowRadius="6"/>

            <!-- Connection status + server -->
            <TextView
                android:id="@+id/tvConnInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mgr_teal_bright"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>

            <ProgressBar
                android:id="@+id/progressMgr"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/mgr_teal"
                android:visibility="gone"/>

            <com.funGames.app.ui.ConnectionStatusView
                android:id="@+id/connStatusMgr"
                android:layout_width="wrap_content"
                android:layout_height="18dp"/>
        </LinearLayout>

        <!-- ══════════ TABS ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:background="#DD050810"
            android:elevation="6dp">

            <TextView
                android:id="@+id/tabGames"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/tab_games"
                android:textColor="@color/mgr_teal_bright"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_mgr_tab"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="#22FFFFFF"/>

            <TextView
                android:id="@+id/tabProvider"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/tab_provider"
                android:textColor="@color/mgr_tab_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_mgr_tab"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="#22FFFFFF"/>

            <TextView
                android:id="@+id/tabPlayer"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/tab_player"
                android:textColor="@color/mgr_tab_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_mgr_tab"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="#22FFFFFF"/>

            <TextView
                android:id="@+id/tabSystem"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/tab_system"
                android:textColor="@color/mgr_tab_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_mgr_tab"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- ══════════ PANE BODY ══════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ── GAMES PANE ── -->
            <ScrollView
                android:id="@+id/paneGames"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="40dp">

                    <!-- Section header -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <View android:layout_width="3dp" android:layout_height="20dp"
                            android:background="@color/mgr_teal"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mgr_games_title"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mgr_games_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="20dp"/>

                    <!-- Add Game card -->
                    <LinearLayout
                        android:id="@+id/btnAddGame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_action_card"
                        android:padding="20dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="6dp">

                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_badge_gold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:text="+"
                                android:textColor="@color/bg_dark" android:textSize="30sp"
                                android:textStyle="bold" android:includeFontPadding="false"/>
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/action_add_game_title"
                                android:textColor="@color/text_primary" android:textSize="16sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/action_add_game_desc"
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/accent_gold"
                            android:textSize="30sp" android:textStyle="bold"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <!-- Change Risk card -->
                    <LinearLayout
                        android:id="@+id/btnChangeRisk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_action_card"
                        android:padding="20dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="6dp">

                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_badge_teal"/>
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:text="⚙"
                                android:textColor="#FFFFFF" android:textSize="24sp"
                                android:includeFontPadding="false"/>
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/action_risk_title"
                                android:textColor="@color/text_primary" android:textSize="16sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/action_risk_desc"
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/mgr_teal_bright"
                            android:textSize="30sp" android:textStyle="bold"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <!-- Remove Game card -->
                    <LinearLayout
                        android:id="@+id/btnRemoveGame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_action_card_danger"
                        android:padding="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="6dp">

                        <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_badge_red"/>
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:text="×"
                                android:textColor="#FFFFFF" android:textSize="30sp"
                                android:textStyle="bold" android:includeFontPadding="false"/>
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/action_remove_title"
                                android:textColor="@color/text_primary" android:textSize="16sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/action_remove_desc"
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/lose_red"
                            android:textSize="30sp" android:textStyle="bold"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- ── BY PROVIDER PANE ── -->
            <LinearLayout
                android:id="@+id/paneProvider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_mgr_card"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_badge_teal"/>
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:text="∑"
                                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
                                android:includeFontPadding="false"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:text="@string/mgr_provider_title"
                            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/mgr_provider_desc"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="10dp" android:lineSpacingExtra="2dp"/>
                    <Button android:id="@+id/btnRunProvider"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="@string/btn_run_query"
                        android:textColor="@color/bg_dark" android:textStyle="bold"
                        android:textSize="14sp" android:letterSpacing="0.14" android:textAllCaps="true"
                        android:background="@drawable/btn_primary"
                        android:layout_marginTop="16dp" android:elevation="4dp"/>
                </LinearLayout>

                <com.funGames.app.ui.StatsChartView
                    android:id="@+id/chartProvider"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="12dp" android:layout_marginBottom="6dp">
                    <View android:layout_width="3dp" android:layout_height="12dp"
                        android:background="@color/mgr_teal" android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OUTPUT" android:textColor="@color/mgr_teal_bright"
                        android:textSize="10sp" android:letterSpacing="0.22" android:textStyle="bold"/>
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginStart="10dp"/>
                    <Button android:id="@+id/btnCopyProvider"
                        android:layout_width="wrap_content" android:layout_height="28dp"
                        android:text="📋" android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:minWidth="36dp" android:padding="0dp"/>
                </LinearLayout>

                <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:background="@drawable/bg_stats_output"
                    android:padding="14dp" android:scrollbars="vertical">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:id="@+id/tvOutputProvider"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/msg_no_stats"
                            android:textColor="@color/mgr_teal_bright" android:textSize="12sp"
                            android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                    </HorizontalScrollView>
                </ScrollView>
            </LinearLayout>

            <!-- ── BY PLAYER PANE ── -->
            <LinearLayout
                android:id="@+id/panePlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_mgr_card"
                    android:padding="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_badge_gold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:text="♛"
                                android:textColor="@color/bg_dark" android:textSize="18sp" android:textStyle="bold"
                                android:includeFontPadding="false"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:text="@string/mgr_player_title"
                            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/mgr_player_desc"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="10dp" android:lineSpacingExtra="2dp"/>
                    <Button android:id="@+id/btnRunPlayer"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="@string/btn_run_query"
                        android:textColor="@color/bg_dark" android:textStyle="bold"
                        android:textSize="14sp" android:letterSpacing="0.14" android:textAllCaps="true"
                        android:background="@drawable/btn_primary"
                        android:layout_marginTop="16dp" android:elevation="4dp"/>
                </LinearLayout>

                <com.funGames.app.ui.StatsChartView
                    android:id="@+id/chartPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="12dp" android:layout_marginBottom="6dp">
                    <View android:layout_width="3dp" android:layout_height="12dp"
                        android:background="@color/mgr_teal" android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OUTPUT" android:textColor="@color/mgr_teal_bright"
                        android:textSize="10sp" android:letterSpacing="0.22" android:textStyle="bold"/>
                    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginStart="10dp"/>
                    <Button android:id="@+id/btnCopyPlayer"
                        android:layout_width="wrap_content" android:layout_height="28dp"
                        android:text="📋" android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:minWidth="36dp" android:padding="0dp"/>
                </LinearLayout>

                <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:background="@drawable/bg_stats_output"
                    android:padding="14dp" android:scrollbars="vertical">
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:id="@+id/tvOutputPlayer"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/msg_no_stats"
                            android:textColor="@color/mgr_teal_bright" android:textSize="12sp"
                            android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                    </HorizontalScrollView>
                </ScrollView>

                <!-- Leaderboard section -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_mgr_card"
                    android:padding="16dp" android:layout_marginTop="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LEADERBOARD"
                        android:textColor="@color/mgr_teal_bright" android:textSize="13sp"
                        android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="All players ranked by total P/L"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>
                    <Button android:id="@+id/btnRunLeaderboard"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="RUN LEADERBOARD"
                        android:textColor="@color/bg_dark" android:textStyle="bold"
                        android:textSize="14sp" android:letterSpacing="0.14" android:textAllCaps="true"
                        android:background="@drawable/btn_primary"
                        android:elevation="4dp"/>
                </LinearLayout>

                <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_stats_output"
                    android:padding="14dp" android:scrollbars="vertical"
                    android:minHeight="80dp">
                    <TextView android:id="@+id/tvOutputLeaderboard"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Press RUN LEADERBOARD to load"
                        android:textColor="@color/mgr_teal_bright" android:textSize="12sp"
                        android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </ScrollView>

            </LinearLayout>

            <!-- ── SYSTEM PANE ── -->
            <ScrollView
                android:id="@+id/paneSystem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/bg_mgr_card"
                        android:padding="24dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">
                            <View android:layout_width="3dp" android:layout_height="18dp"
                                android:background="@color/mgr_teal" android:layout_marginEnd="12dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/mgr_system_title"
                                android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Signed in pod -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:background="@drawable/bg_info_pod"
                            android:padding="18dp" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="SIGNED IN AS"
                                android:textColor="@color/text_muted" android:textSize="9sp"
                                android:letterSpacing="0.22" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvManagerIdSystem"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="" android:textColor="@color/accent_gold"
                                android:textSize="22sp" android:textStyle="bold"
                                android:fontFamily="monospace" android:layout_marginTop="6dp"
                                android:shadowColor="#66FFD84A" android:shadowRadius="10"/>
                        </LinearLayout>

                        <!-- Connection pod -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:background="@drawable/bg_info_pod"
                            android:padding="18dp" android:layout_marginBottom="24dp">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <View android:layout_width="8dp" android:layout_height="8dp"
                                    android:background="@drawable/dot_live" android:layout_marginEnd="8dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="MASTER CONNECTION"
                                    android:textColor="@color/mgr_teal_bright" android:textSize="9sp"
                                    android:letterSpacing="0.22" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:id="@+id/tvConnInfoSystem"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="" android:textColor="@color/text_primary"
                                android:textSize="16sp" android:fontFamily="monospace"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Worker Status section -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:background="@drawable/bg_info_pod"
                            android:padding="16dp" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="WORKER STATUS"
                                android:textColor="@color/accent_gold" android:textSize="11sp"
                                android:textStyle="bold" android:letterSpacing="0.18"
                                android:layout_marginBottom="10dp"/>
                            <Button android:id="@+id/btnWorkerStatus"
                                android:layout_width="match_parent" android:layout_height="44dp"
                                android:text="CHECK WORKERS"
                                android:textColor="@color/bg_dark" android:textStyle="bold"
                                android:textSize="13sp" android:background="@drawable/btn_primary"
                                android:layout_marginBottom="8dp"/>
                            <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:background="@drawable/bg_stats_output" android:padding="10dp"
                                android:minHeight="60dp">
                                <TextView android:id="@+id/tvOutputWorkerStatus"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Press CHECK WORKERS"
                                    android:textColor="@color/accent_gold" android:textSize="11sp"
                                    android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                            </ScrollView>
                        </LinearLayout>

                        <!-- Stress Test section -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:background="@drawable/bg_info_pod"
                            android:padding="16dp" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="STRESS TEST"
                                android:textColor="@color/accent_gold" android:textSize="11sp"
                                android:textStyle="bold" android:letterSpacing="0.18"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Runs 50 concurrent bets to test system under load"
                                android:textColor="@color/text_secondary" android:textSize="11sp"
                                android:layout_marginBottom="10dp"/>
                            <Button android:id="@+id/btnStressTest"
                                android:layout_width="match_parent" android:layout_height="44dp"
                                android:text="RUN STRESS TEST (50 bets)"
                                android:textColor="@color/bg_dark" android:textStyle="bold"
                                android:textSize="13sp" android:background="@drawable/btn_primary"
                                android:layout_marginBottom="8dp"/>
                            <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:background="@drawable/bg_stats_output" android:padding="10dp"
                                android:minHeight="60dp">
                                <TextView android:id="@+id/tvOutputStressTest"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Press RUN STRESS TEST"
                                    android:textColor="@color/accent_gold" android:textSize="11sp"
                                    android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                            </ScrollView>
                        </LinearLayout>

                        <Button android:id="@+id/btnLogoutMgr"
                            android:layout_width="match_parent" android:layout_height="54dp"
                            android:text="@string/btn_logout_mgr"
                            android:textColor="@color/mgr_teal" android:textStyle="bold"
                            android:textSize="15sp" android:letterSpacing="0.12" android:textAllCaps="true"
                            android:background="@drawable/btn_mgr_secondary"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

        </FrameLayout>
    </LinearLayout>
</FrameLayout>
