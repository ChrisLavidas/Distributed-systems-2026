<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0 — animated casino background -->
    <com.funGames.app.ui.CasinoBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1 — content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="52dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <!-- HERO logo -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_casino_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Casino Logo" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="#FFD84A"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginTop="18dp"
                android:shadowColor="#88FFD84A"
                android:shadowRadius="20"
                android:shadowDx="0"
                android:shadowDy="0" />

            <!-- gold divider -->
            <View android:layout_width="60dp" android:layout_height="2dp"
                android:background="#FFD84A" android:layout_marginTop="16dp"
                android:alpha="0.8" />
            <View android:layout_width="30dp" android:layout_height="1dp"
                android:background="#88D4AF37" android:layout_marginTop="4dp" />

            <!-- ROLE TOGGLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="26dp">

                <TextView
                    android:id="@+id/chipRolePlayer"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/role_player"
                    android:textColor="@color/role_chip_text"
                    android:textStyle="bold" android:textSize="13sp"
                    android:letterSpacing="0.16"
                    android:background="@drawable/role_chip_bg"
                    android:clickable="true" android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipRoleManager"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/role_manager"
                    android:textColor="@color/role_chip_text"
                    android:textStyle="bold" android:textSize="13sp"
                    android:letterSpacing="0.16"
                    android:background="@drawable/role_chip_bg"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <!-- CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="22dp"
                android:layout_marginTop="20dp"
                android:elevation="8dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="3dp" android:layout_height="14dp"
                        android:background="#FFD84A" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/lblUserId"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/lbl_player_id" style="@style/SectionLabel" />
                </LinearLayout>

                <EditText android:id="@+id/etPlayerId"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:hint="@string/hint_player_id"
                    android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:inputType="textCapCharacters" android:maxLength="6"
                    android:importantForAutofill="no" android:layout_marginTop="12dp" />

                <LinearLayout android:id="@+id/rowBalance"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <EditText android:id="@+id/etInitialBalance"
                        android:layout_width="match_parent" android:layout_height="54dp"
                        android:hint="@string/hint_initial_balance"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                        android:background="@drawable/bg_input"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:inputType="numberDecimal" android:layout_marginTop="10dp"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="20dp" android:layout_marginBottom="18dp" />

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="3dp" android:layout_height="14dp"
                        android:background="#FFD84A" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/section_server_config" style="@style/SectionLabel" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <EditText android:id="@+id/etMasterHost"
                        android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="2"
                        android:hint="@string/hint_master_host" android:text="10.0.2.2"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                        android:background="@drawable/bg_input"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:inputType="text" android:importantForAutofill="no" />
                    <EditText android:id="@+id/etMasterPort"
                        android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
                        android:hint="@string/hint_master_port" android:text="5000"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                        android:background="@drawable/bg_input"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:inputType="number" android:layout_marginStart="10dp"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

        <Button android:id="@+id/btnLogin"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:text="@string/btn_login_player"
                android:textColor="@color/bg_dark" android:textStyle="bold"
                android:textSize="15sp" android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="24dp" android:elevation="10dp" />

            <Space android:layout_width="match_parent" android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
