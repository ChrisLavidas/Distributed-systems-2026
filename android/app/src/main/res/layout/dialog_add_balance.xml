<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="24dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💰" android:textSize="24sp"
            android:layout_marginEnd="10dp" android:includeFontPadding="false"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/dlg_addbal_title"
            android:textColor="@color/accent_gold" android:textSize="19sp" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dlg_addbal_subtitle"
        android:textColor="@color/text_secondary" android:textSize="12sp"
        android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>

    <!-- Quick presets -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="QUICK ADD" android:textColor="@color/text_muted"
        android:textSize="10sp" android:letterSpacing="0.2" android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="16dp">

        <Button android:id="@+id/btnPreset100"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:text="+100" android:textColor="@color/bg_dark" android:textStyle="bold"
            android:textSize="12sp" android:background="@drawable/btn_primary"
            android:layout_marginEnd="6dp" android:minWidth="0dp"/>

        <Button android:id="@+id/btnPreset500"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:text="+500" android:textColor="@color/bg_dark" android:textStyle="bold"
            android:textSize="12sp" android:background="@drawable/btn_primary"
            android:layout_marginEnd="6dp" android:minWidth="0dp"/>

        <Button android:id="@+id/btnPreset1000"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:text="+1000" android:textColor="@color/bg_dark" android:textStyle="bold"
            android:textSize="12sp" android:background="@drawable/btn_primary"
            android:minWidth="0dp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CUSTOM AMOUNT" style="@style/SectionLabel" android:layout_marginBottom="8dp"/>

    <EditText android:id="@+id/etAmount"
        android:layout_width="match_parent" android:layout_height="54dp"
        android:hint="@string/hint_amount"
        android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:inputType="numberDecimal" android:importantForAutofill="no"
        android:textSize="15sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="20dp">

        <Button android:id="@+id/btnCancel"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
            android:text="@string/btn_cancel" android:textColor="@color/accent_gold"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.12"
            android:textAllCaps="true" android:background="@drawable/btn_secondary"/>

        <Button android:id="@+id/btnAdd"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
            android:text="@string/btn_add" android:textColor="@color/bg_dark"
            android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.12"
            android:textAllCaps="true" android:background="@drawable/btn_primary"
            android:layout_marginStart="12dp" android:elevation="4dp"/>
    </LinearLayout>
</LinearLayout>
