<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_game_card"
    android:padding="14dp"
    android:layout_marginTop="10dp"
    android:elevation="5dp"
    android:clickable="true"
    android:focusable="true">

    <!-- HEADER -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <FrameLayout android:layout_width="50dp" android:layout_height="50dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_logo_placeholder" />
            <TextView android:id="@+id/tvLogoLetter"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/bg_dark" android:textStyle="bold"
                android:textSize="22sp" android:text="?"
                android:includeFontPadding="false" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView android:id="@+id/tvGameName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Game Name" style="@style/CardTitle"
                android:textSize="15sp" android:maxLines="1" android:ellipsize="end"
                android:shadowColor="#44FFD84A" android:shadowRadius="6"
                android:shadowDx="0" android:shadowDy="0" />

            <TextView android:id="@+id/tvProvider"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Provider" style="@style/CardSubtitle"
                android:textSize="11sp" android:layout_marginTop="2dp"
                android:maxLines="1" android:ellipsize="end" />

            <TextView android:id="@+id/tvStars"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="★★★★☆  4.0"
                android:textColor="#FFD84A" android:textSize="11sp"
                android:textStyle="bold" android:layout_marginTop="3dp"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="10dp" android:layout_marginBottom="10dp" />

    <!-- BET INFO -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BET RANGE"
            android:textColor="@color/text_muted" android:textSize="9sp"
            android:letterSpacing="0.18" android:textStyle="bold" />

        <TextView android:id="@+id/tvBetRange"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0.10 – 10.00 FUN"
            android:textColor="@color/text_primary" android:textSize="12sp"
            android:textStyle="bold" android:layout_marginTop="2dp" />

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView android:id="@+id/pillRisk"
                style="@style/RiskPill"
                android:background="@drawable/bg_risk_low"
                android:textColor="@color/risk_low"
                android:text="LOW RISK" />

            <TextView android:id="@+id/pillJackpot"
                style="@style/RiskPill"
                android:background="@drawable/bg_jackpot_pill"
                android:textColor="#FFD84A"
                android:text="JACKPOT"
                android:layout_marginStart="5dp" />

            <TextView android:id="@+id/pillBetCat"
                style="@style/RiskPill"
                android:background="@drawable/bg_jackpot_pill"
                android:textColor="#34D399"
                android:text="$"
                android:layout_marginStart="5dp" />

            <!-- Spacer -->
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- RATE button -->
            <Button android:id="@+id/btnRate"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:text="@string/btn_rate"
                android:textColor="#FFD84A" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:background="@drawable/btn_secondary"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:minWidth="0dp" />

            <!-- PLAY button -->
            <Button android:id="@+id/btnPlay"
                android:layout_width="wrap_content" android:layout_height="38dp"
                android:text="PLAY"
                android:textColor="@color/bg_dark" android:textStyle="bold"
                android:textSize="12sp" android:letterSpacing="0.18"
                android:background="@drawable/btn_primary"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:minWidth="0dp"
                android:layout_marginStart="8dp" android:elevation="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
